# Sao chép file này thành .env rồi điền giá trị thật.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# Không commit file .env.

# ----- Demo Gemma (Google AI Studio) -----
# Tạo khóa tại https://aistudio.google.com/  (Generative Language API)
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# ----- Dashboard / SDK đăng nhập stack AIM -----
AIM_API_URL=http://127.0.0.1:8080
AIM_ADMIN_EMAIL=admin@ptit.edu.vn
AIM_ADMIN_PASSWORD=doi-mat-khau-tren-may-cua-ban

# ----- Docker Compose (docker-compose.quickstart.yml) -----
# Tạo chuỗi ngẫu nhiên, ví dụ:
#   python -c "import secrets; print(secrets.token_hex(16))"
#   python -c "import secrets; print(secrets.token_hex(32))"
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
COMPOSE_PROJECT_NAME=aim
AIM_PROJECT=aim
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
REDIS_PASSWORD=CHANGE_ME_REDIS
JWT_SECRET=CHANGE_ME_JWT_32_BYTES_HEX
KEYVAULT_MASTER_KEY=CHANGE_ME_KEYVAULT_BASE64
ADMIN_EMAIL=admin@ptit.edu.vn
ADMIN_PASSWORD=doi-mat-khau-tren-may-cua-ban
AIM_PLATFORM_ADMINS=admin@ptit.edu.vn
AIM_BACKEND_PORT=8080
AIM_FRONTEND_PORT=3000
AIM_POSTGRES_PORT=5432
AIM_REDIS_PORT=6379
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_API_URL=http://localhost:8080
ENVIRONMENT=development
